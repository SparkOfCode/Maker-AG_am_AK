<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="#N~$,BUZd6bR|;Sg8Ux?" x="20" y="20"><statement name="HANDLER"><block type="typescript_statement" id="fis00APw0)htA*ts0gg9"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace MakerAG {" line1="" line2="    //%block" line3="    export function Greifer(Position: number, Ziel: number) {" line4="        while (Position &lt; Ziel) {" line5="            Position += 1" line6="            calliBot2.servo(C2Servo.Servo1, Position)" line7="            basic.pause(30)" line8="        }" line9="        while (Position &gt; Ziel) {" line10="            Position += -1" line11="            calliBot2.servo(C2Servo.Servo1, Position)" line12="            basic.pause(30)" line13="        }" line14="    }" line15="}" numlines="16"></mutation></block></statement></block><block type="device_forever" id=";CiMg@vu@B2CMAcf9[U?" x="634" y="20"></block></xml>
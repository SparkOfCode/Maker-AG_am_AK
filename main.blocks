<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="0Dv8g7hwn=Yo1Q7RHW6F" x="0" y="0"><statement name="HANDLER"><block type="typescript_statement" id="KiP/Cp;{cXZO#%:-bun?"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace MakerAG {" line1="" line2="//% block" line3="    export let Position2 = 2" line4="    /**" line5="     * Displays a greeting for the player to read." line6="     */" line7="    export function Greifer (Ziel: number) {" line8="    while (Position2 &lt; Ziel) {" line9="        Position2 += 1" line10="        calliBot2.servo(C2Servo.Servo1, Position2)" line11="        basic.pause(30)" line12="    }" line13="    while (Position2 &gt; Ziel) {" line14="        Position2 += -1" line15="        calliBot2.servo(C2Servo.Servo1, Position2)" line16="        basic.pause(30)" line17="    }" line18="    }" line19="}" numlines="20"></mutation></block></statement></block><block type="device_forever" id="mL.n*YkM=Dm/,PqF^wrK" x="517" y="0"></block></xml>
<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="vF4Lfe!6nO}Efv)aNdSV" x="20" y="20"><statement name="HANDLER"><block type="typescript_statement" id="z58YvOGi:1?8|`Y5(=,l"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace MakerAG {" line1="" line2="//% block" line3="    /**" line4="     * Setze den Greifer von der aktuellen auf eine neue Position" line5="     */" line6="    export function Greifer (Position: number, Ziel: number) {" line7="    while (Position &lt; Ziel) {" line8="        Position += 1" line9="        calliBot2.servo(C2Servo.Servo1, Position)" line10="        basic.pause(30)" line11="    }" line12="    while (Position &gt; Ziel) {" line13="        Position += -1" line14="        calliBot2.servo(C2Servo.Servo1, Position)" line15="        basic.pause(30)" line16="    }" line17="    }" line18="}" numlines="19"></mutation></block></statement></block><block type="device_forever" id="1W,LAY/_J+!7m]Q:uJIi" x="669" y="20"></block></xml>
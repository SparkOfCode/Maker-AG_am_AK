<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="fMQ%7:ZRIl]qOLV.qMO!" x="0" y="0"><statement name="HANDLER"><block type="typescript_statement" id="vsV/OVf-a~e8#3Y2nz0c"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace MakerAG {" line1="" line2="//% block" line3="    /**" line4="     * Displays a greeting for the player to read." line5="     */" line6="    export function Greifer (Position2: number, Ziel: number) {" line7="    while (Position2 &lt; Ziel) {" line8="        Position2 += 1" line9="        calliBot2.servo(C2Servo.Servo1, Position2)" line10="        basic.pause(30)" line11="    }" line12="    while (Position2 &gt; Ziel) {" line13="        Position2 += -1" line14="        calliBot2.servo(C2Servo.Servo1, Position2)" line15="        basic.pause(30)" line16="    }" line17="    }" line18="}" numlines="19"></mutation></block></statement></block><block type="device_forever" id="/SV+,]Sw#^j{AWk#dUGR" x="517" y="0"></block></xml>
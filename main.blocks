<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="!!;A-!F_N%xFTu_RO+vm" x="0" y="0"><statement name="HANDLER"><block type="typescript_statement" id="+4UuHiAXL:jr@k[;QD)`"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace MakerAG {" line1="" line2="//% block" line3="    /**" line4="     * Setze den Greifer von der aktuellen auf eine neue Position" line5="     */" line6="    export function Greifer (Position: number, Ziel: number) {" line7="" line8="    while (Position &lt; Ziel) {" line9="        Position += 1" line10="        calliBot2.servo(C2Servo.Servo1, Position)" line11="        basic.pause(30)" line12="    }" line13="    while (Position &gt; Ziel) {" line14="        Position += -1" line15="        calliBot2.servo(C2Servo.Servo1, Position)" line16="        basic.pause(30)" line17="    }" line18="    }" line19="}" numlines="20"></mutation></block></statement></block><block type="device_forever" id=")_Qb*%aiboqO,!/n*Y1_" x="649" y="0"></block></xml>